# ---- ROS 2 / colcon ----
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# ---- ESP-IDF firmware ----
firmware-esp/**/build/
firmware-esp/**/sdkconfig.old
firmware-esp/**/managed_components/
firmware-esp/**/dependencies.lock

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- editor / OS ----
.vscode/
.DS_Store
*.swp

# ---- data / models (usually too big for git) ----
# NOTE: .gitignore has NO inline comments -- '#' is only a comment at line start.
# collected images + cached teacher targets (many GB, regenerable)
data/
# training checkpoints
runs/
# camera-calibration capture images
calib_image/
calib_imgs/
# TensorRT engines (hardware-specific), ONNX, torch checkpoints, INT8 calib cache
*.engine
*.onnx
*.pth
*.cache
*.ply
*.bag
*.db3
